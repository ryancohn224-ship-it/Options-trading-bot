# Copy to .env and fill in. Never commit the filled-in version.

# Paper keys from https://app.alpaca.markets/paper/dashboard/overview
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# `opra` is the paid OPRA feed and the only one with reliable sizes and greeks.
# `indicative` is free and will fail the liquidity gate on nearly every chain —
# that is the gate working correctly, not a threshold to lower.
ALPACA_OPTIONS_FEED=opra

# Live trading additionally requires this exact value. Setting `mode: live` in
# agent.yaml without it will not trade. Two locks, deliberately.
# TRADING_AGENT_ALLOW_LIVE=yes-i-have-read-the-risk-section
